# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env file.

# Security
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave DATABASE_URL empty to use SQLite (development).
# Example PostgreSQL URL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Email (development uses console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Internship Management <noreply@example.com>

# Application
TIME_ZONE=UTC
ATTENDANCE_WARNING_THRESHOLD=75
MAX_UPLOAD_SIZE_MB=5
